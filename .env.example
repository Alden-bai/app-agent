# Copy to .env and fill in your own Beijing API key. Never commit .env.
DASHSCOPE_API_KEY=
# Model, endpoint and context settings: configs/harness/qwen3.5-flash.json

# OpenAI / GPT-6 Luna. Fill only the key in the local .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# Actor/Judge configuration: configs/harness/gpt-6-luna.json
# For python -m scripts.judge_rate_limit, set these from your project's limits.
# JUDGE_OPENAI_RPM=4500
# JUDGE_OPENAI_TPM=1800000

# SwanLab: configuring the key enables tracking for collect/evaluate.
SWANLAB_API_KEY=
SWANLAB_PROJECT=awm-agent
# Optional organization; empty uses your personal workspace.
SWANLAB_WORKSPACE=
# Optional override: online / offline / disabled (auto when unset).
# SWANLAB_MODE=online
